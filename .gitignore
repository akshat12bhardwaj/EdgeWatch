# Datasets and captures: never committed or redistributed (DATASET_SELECTION §6)
# Anchored with a leading slash, because a bare data/ would also match docs/data/
/data/*
!/data/SOURCES.md
!/data/MANIFEST.sha256
*.pcap
*.pcapng
*.cap
*.pcap.gz
*.pcapng.gz
*.parquet

# Credentials
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key
*.p12
*.pfx
mosquitto.passwd
passwd

# Python environments and caches
.venv/
venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Node and dashboard build output
node_modules/
dist/

# Generated artefacts
# Research evidence stays local; publication includes source and documentation only.
/results/
/edgewatch-data/
/models/
/raw/
/reference/
/engineering/
/reports/
credentials.json
secrets.h
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.onnx
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.pcap.*
*.pcapng.*
*.joblib
*.sqlite
*.sqlite3
*.db
*.log

